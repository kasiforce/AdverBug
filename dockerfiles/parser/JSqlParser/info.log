    testImplementation 'org.openjdk.jmh:jmh-core:+'
    testImplementation 'org.openjdk.jmh:jmh-generator-annprocess:+'

    // Java Doc in XML Format
    xmlDoclet ('com.manticore-projects.tools:xml-doclet:+'){ changing = true }

    // enforce latest version of JavaCC
    testImplementation('com.manticore-projects.jsqlformatter:javacc-core:[8.1.2.1941,)')
    testImplementation('com.manticore-projects.jsqlformatter:javacc-java:[8.1.2.1941,)')

    jmh 'org.openjdk.jmh:jmh-core:+'
    jmh 'org.openjdk.jmh:jmh-generator-annprocess:+'
    javacc('com.manticore-projects.jsqlformatter:javacc-core:[8.1.2.1941,)')
