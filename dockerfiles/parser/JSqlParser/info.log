                        <configuration>
                            <javaccCmdLineArgs>
                                <arg>-CODE_GENERATOR:"Java"</arg>
                                <arg>-GRAMMAR_ENCODING:"UTF-8"</arg>
                            </javaccCmdLineArgs>
                            <jjtreeCmdLineArgs>
                                <arg>-GRAMMAR_ENCODING:"UTF-8"</arg>
                                <arg>-CODE_GENERATOR:"Java"</arg>
                            </jjtreeCmdLineArgs>
                        </configuration>
