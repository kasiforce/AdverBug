tasks.register('xslt', SaxonXsltTask) {
    def outFile = version.endsWith("-SNAPSHOT")
            ? file("src/site/sphinx/syntax_snapshot.rst")
            : file("src/site/sphinx/syntax_stable.rst")

    dependsOn(renderRR)
    stylesheet file('src/main/resources/rr/xhtml2rst.xsl')

    parameters(
            "withFloatingToc": System.getProperty("FLOATING_TOC", "false"),
            "isSnapshot": Boolean.toString(version.endsWith("-SNAPSHOT"))
    )

    // Transform every .xml file in the "input" directory.
    input layout.buildDirectory.file("rr/JSqlParserCC.xhtml").get()
    output outFile
}

tasks.register('sphinx', Exec) {
    dependsOn(gitChangelogTask, renderRR, xslt, xmldoc)

    String PROLOG = """
.. |_| unicode:: U+00A0
    :trim:

.. |JSQLPARSER_EMAIL| replace:: support@manticore-projects.com
.. |JSQLPARSER_VERSION| replace:: ${getVersion(false)}
.. |JSQLPARSER_SNAPSHOT_VERSION| replace:: ${getVersion(true)}
.. |JSQLPARSER_STABLE_VERSION_LINK| raw:: html

    <a href='http://manticore-projects.com/download/${project.name}-${getVersion(false)}/${project.name}-${getVersion(false)}.jar'>${project.name}-${getVersion(false)}.jar</a>

.. |JSQLPARSER_SNAPSHOT_VERSION_LINK| raw:: html

    <a href='http://manticore-projects.com/download/${project.name}-${getVersion(false)}/${project.name}-${getVersion(true)}.jar'>${project.name}-${getVersion(true)}.jar</a>

"""

    args = [
            "-Dproject=JSQLParser"
            , "-Dcopyright=Tobias Warneke, 2022"
            , "-Dauthor=Tobias Warneke"
            , "-Drelease=${getVersion(false)}"
            , "-Drst_prolog=$PROLOG"
            , "${projectDir}/src/site/sphinx"
            , layout.buildDirectory.file("sphinx").get().asFile
    ]

    executable "sphinx-build"

    //store the output instead of printing to the console:
    standardOutput = new ByteArrayOutputStream()

    //extension method stopTomcat.output() can be used to obtain the output:
    ext.output = {
        return standardOutput.toString()
    }
}

// `publish` is Gradle's own task; the Central Portal upload runs under `publishToMavenCentral`.
// Both need the same prerequisites, or a CI job invoking the latter silently skips check and docs.
tasks.matching { it.name in ['publish', 'publishToMavenCentral'] }.configureEach {
    dependsOn(check, gitChangelogTask, renderRR, xslt, xmldoc)
}

mavenPublishing {
    publishToMavenCentral(true)
    signAllPublications()

    coordinates(group, "jsqlparser", version)

    pom {
        name.set('JSQLParser library')
        description.set('Parse SQL Statements into Abstract Syntax Trees (AST)')
        url.set('https://github.com/JSQLParser/JSqlParser')

        licenses {
            license {
                name.set('GNU Library or Lesser General Public License (LGPL) V2.1')
                url.set('http://www.gnu.org/licenses/lgpl-2.1.html')
            }
            license {
                name.set('The Apache Software License, Version 2.0')
                url.set('http://www.apache.org/licenses/LICENSE-2.0.txt')
            }
        }

        developers {
            developer {
                id.set('twa')
                name.set('Tobias Warneke')
                email.set('t.warneke@gmx.net')
            }
            developer {
                id.set('are')
                name.set('Andreas Reichel')
                email.set('andreas@manticore-projects.com')
            }
        }

        scm {
            connection.set('scm:git:https://github.com/JSQLParser/JSqlParser.git')
            developerConnection.set('scm:git:ssh://git@github.com:JSQLParser/JSqlParser.git')
            url.set('https://github.com/JSQLParser/JSqlParser.git')
        }
    }
}

// Signing and its task wiring are handled by mavenPublishing.signAllPublications() above.
// The manual `signing { required { ... hasTask("publish") } }` block that used to live here
// never matched the `publishToMavenCentral` task, so the two disagreed about whether to sign.

tasks.withType(JavaCompile).configureEach {
    options.encoding = 'UTF-8'

    // javac's parser is recursive descent: one stack frame per level of nesting. The generated
    // CCJSqlParser is nested deeply enough to exhaust the default thread stack, which surfaces as
    // "An exception has occurred in the compiler ... java.lang.StackOverflowError" - a compiler
    // crash, not a compile error, and not a bug worth reporting to Oracle.
    //
    // -Xss only takes effect at JVM launch, so the compiler has to run in its own process:
    // setting forkOptions without options.fork = true silently does nothing.
    options.fork = true
    options.forkOptions.jvmArgs = (options.forkOptions.jvmArgs ?: []) + ['-Xss16m']
}

// javadoc parses the same sources in a forked process and hits the same wall
tasks.withType(Javadoc).configureEach {
    options.setJFlags((options.getJFlags() ?: []) + ['-Xss16m'])
}

remotes {
    webServer {
        host = findProperty("${project.name}.host") ?: "defaultHost" // Provide default if not found
        user = findProperty("${project.name}.username") ?: "defaultUsername" // Provide default if not found
        identity = file("${System.getProperty('user.home')}/.ssh/id_rsa")
    }
}


tasks.register('upload') {
    doFirst {
        if (findProperty("${project.name}.host") == null) {
            println(
                    """
                Property \"${project.name}.host\' not found.
                Please define \"${project.name}.host\" in the Gradle configuration (e. g. \$HOME/.gradle/gradle.properties.
                """
            )
        }
    }
    doLast {
        ssh.run {
            session(remotes.webServer) {
                def versionStable = getVersion(false)
                execute "mkdir -p download/${project.name}-${versionStable}"
                for (File file: fileTree(include:['*.jar'], dir: layout.buildDirectory.dir("libs").get()).collect()) {
                    put from: file, into: "download/${project.name}-${versionStable}"
                }
            }
        }
    }

    dependsOn(check, assemble, gitChangelogTask, renderRR, xslt, xmldoc)
}

check {
    dependsOn jacocoTestCoverageVerification
}

jmh {
    jmhVersion = '1.37'
    jvmArgs = [
            "--enable-native-access=ALL-UNNAMED"
            , "--add-opens=java.base/sun.misc=ALL-UNNAMED"
            , "--add-opens=java.base/java.lang=ALL-UNNAMED"
            , "-XX:+UnlockDiagnosticVMOptions"
            , "-XX:+DebugNonSafepoints"
    ]

    // Profiling is opt-in because the native library path depends on the host.
    profilers = providers.gradleProperty('jmhProfiler').map { [it] }.getOrElse([])

    includes = ['.*JSQLParserBenchmark.*']
    warmupIterations = 2
    fork = 3
    iterations = 5
    timeOnIteration = '1s'
}

// ---------------------------------------------------------------------------------------------
// Grammar ambiguity gate
//
// JavaCC reports choice conflicts as "Warning: ..." on stdout and still exits 0, so an ambiguity
// introduced by a PR is completely invisible to `./gradlew check`. The `org.javacc.javacc` plugin
// forwards that output to the Gradle logger, where it cannot be inspected either.
//
// This task therefore re-runs JavaCC on the JJTree output, into a throwaway directory, captures
// stdout+stderr and fails when any warning survives the allow list.
// ---------------------------------------------------------------------------------------------

// Regexes for warnings that are known-benign. Add an entry ONLY together with a comment saying
// why. Never add a "Choice conflict" pattern here — that is the thing this gate exists to catch.
def grammarWarningAllowList = [
        // JJTree copies the options block into the .jj; re-passing -OUTPUT_DIRECTORY on the
        // command line makes JavaCC complain that it overrides the in-file value.
        ~/^Warning: .*Command line setting of .* modifies option value in file\./,

        // -OUTPUT_DIRECTORY points at a scratch directory that is wiped before every run, so
        // JavaCC always announces that it is creating it. Housekeeping, not a grammar problem.
        ~/^Warning: Output directory .* does not exist\. Creating the directory\./
]

def javaccMainClassOverride = project.findProperty('javaccMainClass')

tasks.register('checkGrammarAmbiguity') {
    group = 'verification'
    description = 'Fails the build when JavaCC reports choice conflicts (grammar ambiguities).'

    dependsOn(compileJavacc)

    def jjFile = layout.buildDirectory
            .file('generated/jjtree/net/sf/jsqlparser/parser/JSqlParserCC.jj')
    def scratchDir = layout.buildDirectory.dir('grammar-check')
    def reportFile = layout.buildDirectory.file('reports/grammar/javacc-warnings.txt')
    def javaccClasspath = configurations.javacc
    def allowList = grammarWarningAllowList
    def mainClassOverride = javaccMainClassOverride

    inputs.file(jjFile)
    inputs.files(javaccClasspath)
    outputs.file(reportFile)

    doLast {
        def jj = jjFile.get().asFile
        if (!jj.exists()) {
            throw new GradleException("Generated grammar not found: ${jj} — did compileJavacc run?")
        }

        def out = scratchDir.get().asFile
        out.deleteDir()
        out.mkdirs()

        // JavaCC 8 splits into javacc-core / javacc-java; take Main-Class from whichever jar
        // declares one, so this keeps working across upgrades of the Manticore JavaCC branch.
        def mainClass = mainClassOverride ?: javaccClasspath.files.findResult { f ->
            if (!f.name.endsWith('.jar')) {
                return null
            }
            new java.util.jar.JarFile(f).withCloseable { jar ->
                jar.manifest?.mainAttributes?.getValue('Main-Class')
            }
        } ?: 'org.javacc.parser.Main'

        def isWindows = System.getProperty('os.name').toLowerCase(Locale.ROOT).contains('win')
        def javaExe = new File(new File(System.getProperty('java.home'), 'bin'),
                isWindows ? 'java.exe' : 'java')

        def proc = new ProcessBuilder(
                javaExe.absolutePath,
                '-cp', javaccClasspath.asPath,
                mainClass.toString(),
                '-GRAMMAR_ENCODING=UTF-8',
                "-OUTPUT_DIRECTORY=${out.absolutePath}".toString(),
                jj.absolutePath)
                .directory(out)
                .redirectErrorStream(true)
                .start()

        def output = proc.inputStream.getText('UTF-8')
        def exit = proc.waitFor()

        // Warnings are multi-line: a "Warning:" header followed by indented continuation lines.
        def warnings = []
        def current = null
        output.eachLine { line ->
            if (line.startsWith('Warning:')) {
                current = new StringBuilder(line)
                warnings << current
            } else if (current != null && line.startsWith(' ')) {
                current.append('\n').append(line)
            } else {
                current = null
            }
        }

        def offending = warnings
                .collect { it.toString() }
                .findAll { w -> allowList.every { !(w =~ it) } }

        def report = reportFile.get().asFile
        report.parentFile.mkdirs()
        report.setText(offending.isEmpty() ? 'No JavaCC grammar warnings.\n'
                : offending.join('\n\n') + '\n', 'UTF-8')

        if (exit != 0) {
            logger.error(output)
            throw new GradleException("JavaCC exited with ${exit} while analysing the grammar.")
        }

        if (!offending.isEmpty()) {
            def conflicts = offending.count { it.contains('Choice conflict') }
            logger.error("\n${offending.join('\n\n')}\n")
            throw new GradleException(
                    "${offending.size()} JavaCC grammar warning(s), ${conflicts} of them choice " +
                            "conflicts. Resolve the ambiguity or add an explicit LOOKAHEAD to the earlier " +
                            "expansion. Report: ${report}")
        }

        logger.lifecycle('Grammar is free of JavaCC choice conflicts.')
    }
}

tasks.named('check') {
    dependsOn('checkGrammarAmbiguity')
}

